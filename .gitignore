.DS_Store
.claude/
__pycache__/
*.py[cod]

.ipynb_checkpoints/
*.nbconvert.ipynb

.conda/
.venv/
venv/
env/

cache/
# cache/ is itself a symlink to an external disk (2026-07, disk-space workaround) --
# see data/processed/co/valle_aburra/README.md. The trailing-slash pattern above only
# matches a real directory, not a symlink, so it's restated here without the slash to
# make sure the symlink itself never gets staged.
/cache
tmp/
output/
data/interim/
data/processed/**
!data/processed/**/
!data/processed/**/README.md

# Validation annotations are source evidence; generated image tiles and contact
# sheets are artifacts. Keep labels, manifests, CSV queues and README files.
data/validation/**
!data/validation/**/
!data/validation/**/README.md
!data/validation/**/manifest.json
!data/validation/**/*.csv
!data/validation/**/labels/**/*.json
!data/validation/**/labels_second_pass/**/*.json

# Diagnostic and publication figures are generated artifacts.
figures/**
!figures/**/
!figures/**/README.md
webapp/public/data/**
!webapp/public/data/
!webapp/public/data/palette.json
!webapp/public/data/sounds/
!webapp/public/data/sounds/**
webapp/public/data/catalog.json
webapp/public/data/v1/

*.partial
*.partial.csv

# Large local raw datasets. Keep documentation, placeholders and tiny fixtures.
data/raw/**
!data/raw/**/
!data/raw/**/README.md
!data/raw/**/.gitkeep
!data/raw/**/source_manifest.json

# Study boundary/AOI polygons: small, essential reference inputs (not bulk raw
# data), required for reproducibility of a study's spatial contract.
!data/raw/**/aoi/**/*.geojson
!data/raw/**/comunas.geojson
data/raw/deis/**
!data/raw/deis/
!data/raw/deis/**/
!data/raw/deis/**/*.md
!data/raw/deis/**/.gitkeep
!data/raw/deis/**/sample_*.csv

.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local agent/tool caches, not project content.
.opencode/
.playwright-cli/
.playwright-mcp/

# Obsidian: share only stable vault settings. Personal workspace state and
# unreviewed notes stay local.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/templates.json
local-notes/

# Personal CV and submission bundle: unrelated to the exposome pipeline.
CV_Bastian_Ayala_Inostroza/
submission/

# LaTeX build artifacts (keep .tex, .bib, .pdf, figures/)
*.aux
*.bcf
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz

# OpenWiki regenera este workflow en cada `--update`; se mantiene fuera de
# GitHub a propósito (apunta a OpenRouter con un secreto inexistente).
.github/workflows/openwiki-update.yml

# Credenciales de NASA Earthdata (earthaccess login escribe ~/.netrc, pero
# algunas configuraciones lo dejan junto al proyecto). Nunca versionar.
.netrc
_netrc
.edl_token
